# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
SITE_BASE_URL=http://localhost:8000

# Postgres
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kafka (3-broker cluster, see docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_CLICK_TOPIC=click_events

# App tuning
SHORTEN_RATE_LIMIT=10
SHORTEN_RATE_WINDOW_SECONDS=60
REDIRECT_CACHE_TTL_SECONDS=3600

# Security
# Salt used to hash client IPs before storage - set a real random value in production.
IP_HASH_SALT=change-me-in-production
# Only set to true if a reverse proxy in front of this app sets/strips X-Forwarded-For.
# Leaving this false (default) prevents clients from spoofing their IP to dodge rate limiting.
TRUST_X_FORWARDED_FOR=false
